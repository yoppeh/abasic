cc=gcc
ld=gcc
sc=strip
# The instruction callbacks share one signature and most ignore their
# argument, so unused parameters aren't worth a warning.
warnings=-Wall -Wextra -Wno-unused-parameter
# -MMD -MP: the compiler writes a .d file next to each object listing the
# headers it includes, so editing a header rebuilds everything that uses it.
cflags=-O2 -g0 $(warnings) -MMD -MP
lflags=-O2 -g0 -lc -lm

obj=main.o io.o parse.o prog.o scan.o util.o var.o

abasic : $(obj)
	$(ld) -o $@ $(obj) $(lflags)
	$(sc) $@

%.o : %.c
	$(cc) $(cflags) -c $<

# header dependencies generated by -MMD (missing before the first build)
-include $(obj:.o=.d)

.PHONY: clean
clean:
	rm -f abasic $(obj) $(obj:.o=.d)
